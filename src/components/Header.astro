---
import { Mail, Menu, PanelTopClose } from '@lucide/astro';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Marco Salazar, home">
      <span class="brand-mark">MS</span>
      <span class="brand-name">Marco Salazar</span>
    </a>

    <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-button>
      <Menu class="menu-open" size={21} aria-hidden="true" />
      <PanelTopClose class="menu-close" size={21} aria-hidden="true" />
    </button>

    <nav class="primary-nav" aria-label="Primary navigation" data-menu>
      <div class="nav-pages">
        <a class:list={{ active: isActive('/about') }} href="/about/">About</a>
      </div>
      <div class="nav-socials" aria-label="Social links">
        <a href="mailto:marcosalazar16@gmail.com" aria-label="Email" title="Email"><Mail size={18} aria-hidden="true" /><span>Email</span></a>
        <a href="https://github.com/marsalal/" aria-label="GitHub" title="GitHub" target="_blank" rel="noreferrer">
          <svg class="social-brand-icon github-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          <span>GitHub</span>
        </a>
        <a href="https://www.linkedin.com/in/marco-salazar-a8366515/" aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noreferrer"><i class="brand-icon linkedin" aria-hidden="true">in</i><span>LinkedIn</span></a>
        <a href="https://stackoverflow.com/users/600799/marsalal1014" aria-label="Stack Overflow" title="Stack Overflow" target="_blank" rel="noreferrer">
          <svg class="social-brand-icon stackoverflow-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.725 0l-1.72 1.277 6.39 8.588 1.716-1.277L15.725 0zm-3.94 3.418l-1.369 1.644 8.225 6.85 1.369-1.644-8.225-6.85zm-3.15 4.465l-.905 1.94 9.702 4.517.904-1.94-9.701-4.517zm-1.85 4.86l-.44 2.093 10.473 2.201.44-2.092-10.473-2.203zM1.89 15.47V24h19.19v-8.53h-2.133v6.397H4.021v-6.396H1.89zm4.265 2.133v2.13h10.66v-2.13H6.154Z" /></svg>
          <span>Stack Overflow</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-menu]');
  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open', !expanded);
  });
</script>
