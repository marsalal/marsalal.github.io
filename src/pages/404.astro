---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="hero">
    <div class="shell">
      <span class="eyebrow">404 · LOST ROUTE</span>
      <h1>This page took a wrong turn<span>.</span></h1>
      <p class="hero-copy">The link may be outdated, but the writing is still here.</p>
      <div class="hero-actions"><a class="button primary" href="/post/">Browse the articles</a><a class="button" href="/">Go home</a></div>
    </div>
  </section>
</BaseLayout>
