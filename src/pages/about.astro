---
import BaseLayout from '../layouts/BaseLayout.astro';
import { yearsOfExperience } from '../utils/profile';
---

<BaseLayout title="About" description={`Meet Marco Salazar, a software engineer and tech lead with ${yearsOfExperience}+ years of experience building web, mobile, and backend systems.`}>
  <header class="page-hero shell">
    <span class="eyebrow">ABOUT</span>
    <h1>Engineer, team builder, and relentlessly curious human.</h1>
    <p>I care about software that works, teams that grow, and challenges worth chasing.</p>
  </header>
  <div class="shell about-grid">
    <aside class="about-aside">
      <img src="/me_profile.jpeg" alt="Marco Salazar overlooking a city" width="500" height="500" />
      <div>
        <h2>Marco Salazar</h2>
        <p>Software Engineer · Tech Lead</p>
      </div>
    </aside>
    <section class="about-copy">
      <p>I’m a software developer with {yearsOfExperience}+ years of experience across mobile, web, and backend applications. Most of that journey has centered on backend systems, where C# and .NET have become my core specialties.</p>
      <p>I’ve also worked as a technical lead for small and multi-region teams with a wide range of experience levels. My goal is always the same: help every person increase their impact while moving the team toward a shared outcome.</p>
      <p>New challenges keep me moving—in engineering and everywhere else. I’m a dedicated husband, amateur pitmaster, passionate home cook, traveler, and runner who is always looking for the next improvement.</p>
      <div class="about-pillars">
        <div><strong>Reliable systems</strong><span>Resilience, clarity, pragmatic architecture</span></div>
        <div><strong>Healthy teams</strong><span>Leadership, growth, shared ownership</span></div>
        <div><strong>Always learning</strong><span>Engineering, running, cooking, life</span></div>
      </div>
      <div class="hero-actions">
        <a class="button primary" href="mailto:marcosalazar16@gmail.com">Get in touch</a>
        <a class="button" href="https://www.linkedin.com/in/marco-salazar-a8366515/" target="_blank" rel="noreferrer">LinkedIn profile</a>
      </div>
    </section>
  </div>
</BaseLayout>
